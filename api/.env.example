PORT=3500

# ── Directus (CMS) ────────────────────────────────────────────────────
# scripts/service_account.py 가 발급한 정적 토큰. seat 을 먹지 않는 계정이다.
DIRECTUS_URL=http://localhost:3350
DIRECTUS_TOKEN=

# 공개 사이트가 보는 기본 언어. ?lang= 으로 덮어쓴다.
DEFAULT_LANGUAGE=ko-KR

# ── 사내 IAM ──────────────────────────────────────────────────────────
# 게이트웨이 서명 공유 비밀.
# 기본은 검증을 켠 쪽이다. 이 파일을 그대로 복사해서 운영에 올리는 일이
# 생기는데, 그때 열려 있으면 서명 없는 요청이 전부 들어온다.
# 로컬에서 게이트웨이 없이 띄울 때만 각자 .env 에서 false 로 덮는다.
IAM_GATEWAY_SECRET=
IAM_ENFORCE_GATEWAY=true

# ── 메일 (mail_send.php 대체) ─────────────────────────────────────────
# 네이버 클라우드 키. 브라우저로 옮길 수 없어 여기 남는다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_MAIL_API_URL=https://mail.apigw.ntruss.com/api/v1
NCP_MAIL_SENDER_ADDRESS=
NCP_MAIL_TO=

# ── 문의 속도 제한 (mail_send.php 와 같은 이름·기본값) ────────────────
# IP 당 분/시 한도. 넘으면 429.
MAIL_RL_PER_MINUTE=5
MAIL_RL_PER_HOUR=30
# 리버스 프록시(nginx) 뒤에 둘 때 채운다. 앞단 프록시 대수이거나 신뢰할
# 대역이다. **비워 두면 SESSION_SECURE=true 와 겹쳐서 관리자 로그인이
# 조용히 안 된다** — 쿠키가 오류 없이 그냥 안 나간다. IP 별 속도 제한도
# 프록시 주소 하나로 합쳐진다. TLS 를 이 프로세스가 직접 받을 때만 비운다.
TRUST_PROXY=1

# ── 게시판 API (notice_api.php 대체) ─────────────────────────────────
# 앱/게시판 백엔드(게이트웨이) 베이스 URL. **프리픽스까지 포함한다.**
# notice_config.sample.php 의 https://route.drvalue.co.kr 로는 전부 404 다
# (그 호스트는 actuator/health 만 200 이고 라우트가 하나도 안 걸려 있다).
# 아래가 실측으로 확인한 주소다 — root/basic 이 userId/password 를 요구하고
# 게시판 경로가 401(토큰 없음)로 답한다.
# **이건 선택이다.** 게이트웨이 앞단이 아니라 서비스 API 에 직접 붙는 쪽이다.
# 게시판 조회는 이걸로 되지만 관리자 IAM 로그인(root/iam)은 여기서 안 된다.
# route.drvalue.co.kr 의 라우트가 복구되면 그쪽으로 되돌려야 한다.
NOTIFY_API_BASE=https://api.growchat.co.kr/api/serv
# 공개 조회용 서비스 계정(root/basic). 사람 로그인과는 무관하다.
NOTIFY_ROOT_ID=
NOTIFY_ROOT_PW=
NOTIFY_PAGE_SIZE=10
# IAM 로그인 서버 베이스(끝 슬래시 없이).
NOTIFY_IAM_BASE_URL=https://iam.drvalue.co.kr
# 생략하면 {NOTIFY_API_BASE}/auth/v1/login/root/iam
# 주의: 이 경로만 게이트웨이 서명을 요구하고, 서명을 맞춰도 게이트웨이가
# 넣어 주는 x-user-* 헤더를 다시 요구한다. README 의 "관리자 로그인" 참고.
NOTIFY_ROOT_IAM_URL=
# IAM 화이트리스트에 등록된 콜백 주소. **글자 하나까지 같아야 한다.**
# 그래서 Nest 로 옮긴 뒤에도 주소가 .php 그대로다.
NOTIFY_CALLBACK_URL=https://www.drvalue.co.kr/page/support/notice_login_callback.php
NOTIFY_TENANT_CODE=drvalue
# 생략하면 {NOTIFY_API_BASE}/auth/v1/login/tenant/by-root
NOTIFY_TENANT_LOGIN_URL=
# 채팅(growchat) 연동은 이 값을 채워야 켜진다. 비우면 로그인 동작이 기존과 같다.
NOTIFY_CHAT_RESOLVE_KEY=
NOTIFY_CHAT_TOKEN_TTL=3600

# 게이트웨이 서명 공유 비밀. 사내 서비스들이 쓰는 값과 같아야 한다.
# Doppler: drvalue-chat-backend / prd / GATEWAY_SHARED_SECRET.
# 파일에 적지 말고 주입해라:
#   doppler run --project drvalue-chat-backend --config prd \
#     --only-secrets GATEWAY_SHARED_SECRET -- <명령>
# (이 값이 없으면 부팅이 막힌다. 다만 지금 이 값으로 지키는 경로는 0개다 —
#  모든 컨트롤러가 @SkipGatewaySignature() 다.)
IAM_GATEWAY_SECRET=

# ── 관리자 세션 ──────────────────────────────────────────────────────
# 반드시 바꿀 것. 이 값이 새면 남의 세션을 만들 수 있다.
SESSION_SECRET=
# HTTPS 로 서비스하면 true. 비워도 true 로 본다 — 빠뜨린 배포에서 쿠키가
# 평문으로 나가는 것보다 낫다. 로컬에서만 false 를 명시한다.
# true 로 둘 거면 위 TRUST_PROXY 를 반드시 같이 채운다.
SESSION_SECURE=true
# 세션 파일과 채팅 토큰이 쌓이는 곳. 비우면 시스템 임시 폴더.
NOTIFY_STATE_DIR=
