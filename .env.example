# 홈페이지 한 벌(web · api · db)의 환경변수. 루트 .env 하나만 만든다.
#   cp .env.example .env
# 여기 없는 값은 코드 상수이거나 docker-compose.yml 이 컨테이너끼리 잇는 배선이다.

# ═══ 필수 ════════════════════════════════════════════════════════════════

# DB. 운영은 iwinv 관리형 PostgreSQL(컨테이너 밖) — 콘솔의 도메인·포트·DB 이름·계정을 적는다.
# iwinv 콘솔의 「접속 허용 IP」에 서버 공인 IP 가 있어야 붙는다.
# 로컬 개발은 DB_PASSWORD 만 채우면 된다(docker-compose.dev.yml 의 db 컨테이너가 이 값으로 만들어진다).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# 관리 화면 로그인 쿠키(dv_admin)를 서명하는 키. openssl rand -hex 32.
# 이 값을 아는 사람은 관리자 쿠키를 만들 수 있다 — 저장소·로그에 쓰지 않는다. 없으면 api 가 안 뜬다.
ADMIN_SESSION_SECRET=

# IAM 이 로그인 뒤 돌려보낼 주소. IAM 화이트리스트에 같은 값이 있어야 한다.
# https 로 시작하면 쿠키에 Secure 가 붙는다.
ADMIN_IAM_CALLBACK_URL=http://localhost:3400/api/admin/auth/callback

# 문의 메일(네이버 클라우드). 비면 메일만 안 가고 문의는 DB 에 남는다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_MAIL_SENDER_ADDRESS=
NCP_MAIL_TO=

# ═══ 선택 ════════════════════════════════════════════════════════════════
# 관리형 DB 가 TLS 를 받으면 require. 비면 평문으로 붙는다.
DB_SSL=
# web 을 여는 호스트 포트(127.0.0.1 에만 열린다 — 앞단 nginx 가 이리로 넘긴다). 기본 3400.
WEB_PORT=
# 로컬 개발에서만: DB 컨테이너와 개발용 포트를 얹는다. 운영 서버에는 넣지 않는다.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# 방문 통계 GTM id(web 빌드 인자). 비면 GTM·동의 창이 안 실린다 — 미리보기·로컬은 비워 둔다.
# 운영은 GTM-NLL3QGRF. 미리보기 빌드(NOINDEX=1)는 값이 있어도 안 싣는다.
NEXT_PUBLIC_GTM_ID=
