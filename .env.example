# 한 벌(web · api · cms)이 같이 읽는 환경변수. 루트 .env 하나만 만든다.
#   cp .env.example .env
# 컨테이너는 docker-compose.yml 이 이 파일을 넘기고, 로컬 실행은 각 패키지가
# ../.env 를 읽는다. 스크립트는 루트에서 `set -a; . .env; set +a` 로 올린다.
# 포트는 여기 없다 — web 3400 · api 3500 · directus 3350 은 각자 기본값이다.

# ── 공개 화면 (web) ───────────────────────────────────────────────────
# Nest 주소. 컨테이너 안에서는 compose 가 http://api:3500 으로 덮는다.
API_ORIGIN=http://localhost:3500
# 관리 화면 주소. 비우면 안내 문구만 나오고 링크가 안 붙는다.
CMS_ADMIN_URL=http://localhost:3350/admin
# 대표주소·공유카드가 가리킬 곳.
SITE_ORIGIN=https://drvalue.co.kr
# 미리보기 배포에서만 1. 운영에는 넣지 않는다.
NOINDEX=

# ── 백엔드 (api) ──────────────────────────────────────────────────────
# CMS 주소와 서비스 토큰. 토큰은 cms/scripts/service_account.py 가 한 번만 찍는다.
# 컨테이너 안에서는 compose 가 DIRECTUS_URL 을 http://directus:8055 로 덮는다.
DIRECTUS_URL=http://localhost:3350
DIRECTUS_TOKEN=
# 공개 사이트 기본 언어. ?lang= 으로 덮어쓴다.
DEFAULT_LANGUAGE=ko-KR
# 게이트웨이 서명 공유 비밀. 사내 서비스들이 쓰는 값과 같아야 한다.
# Doppler: drvalue-chat-backend / prd / GATEWAY_SHARED_SECRET.
# 검증(IAM_ENFORCE_GATEWAY)은 기본이 켜짐이고, 켜진 채 이 값이 없으면 안 뜬다.
# 로컬에서 게이트웨이 없이 띄울 때만 false 로 덮는다. 운영에는 절대 넣지 않는다.
IAM_GATEWAY_SECRET=
IAM_ENFORCE_GATEWAY=true
# 네이버 클라우드 메일. 브라우저로 옮길 수 없어 여기 남는다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_MAIL_API_URL=https://mail.apigw.ntruss.com/api/v1
NCP_MAIL_SENDER_ADDRESS=
NCP_MAIL_TO=
# 문의 속도 제한. IP 당 분/시 한도. 넘으면 429.
MAIL_RL_PER_MINUTE=5
MAIL_RL_PER_HOUR=30
# 리버스 프록시 뒤에 둘 때 채운다(앞단 프록시 대수 또는 신뢰 대역). 비우면
# req.ip 가 전부 프록시 주소가 돼서 IP 별 한도가 하나로 합쳐진다.
TRUST_PROXY=1

# ── 관리 화면 (web /admin + api /api/admin) ───────────────────────────
# 세션 서명 키. openssl rand -hex 32. 없으면 api 가 안 뜬다.
ADMIN_SESSION_SECRET=
# 사내 IAM. 콜백은 IAM 화이트리스트에 있어야 한다. 로컬은 web 을 거쳐 3400 으로.
ADMIN_IAM_BASE=https://iam.drvalue.co.kr
ADMIN_IAM_CALLBACK_URL=http://localhost:3400/api/admin/auth/callback
# 「drvalue 테넌트의 root 사용자」 = 이 IAM 그룹(uuid)에 아래 역할로 속한 사람. PLATFORM_ADMIN 은 통과.
ADMIN_IAM_GROUP=
ADMIN_IAM_GROUP_ROLES=OWNER,ADMIN
# M.AX(nxcms) 마스터 DB — 「drvalue 테넌트의 root 사용자」의 원본. 읽기 전용 계정으로.
# rn_default_root_user.iamUserId(=IAM sub) · status=ACTIVE · rn_tenant.code 로 판정한다.
# 채우면 이것이 인가다(IAM 그룹은 안 본다). nxcms 에서 빼면 60초 안에 막힌다.
# 비우면 아래 IAM 그룹 판정만 남는다.
ADMIN_MAX_DB_HOST=
ADMIN_MAX_DB_PORT=3306
ADMIN_MAX_DB_NAME=nx_cms_database
ADMIN_MAX_DB_USER=
ADMIN_MAX_DB_PASSWORD=
ADMIN_MAX_TENANT_CODE=drvalue
# IAM 내부 API — 세션 중에도 사용자가 비활성·삭제되면 60초 안에 막는다. Doppler 에 있다.
# 비우면 그 검사만 빠지고 30분 세션 만료 재검만 남는다.
IAM_INTERNAL_API_BASE_URL=
INTERNAL_API_KEY=
# 로컬 http 에서만 false. 비우면 secure 쿠키(https 전용).
ADMIN_COOKIE_SECURE=
# 검사 스크립트가 관리 API 를 부를 때 쓰는 토큰(선택). openssl rand -hex 32.
ADMIN_API_TOKEN=

# ── 데이터베이스 (api 가 직접 읽고 쓴다) ──────────────────────────────
# 컨테이너 안에서는 compose 가 DB_HOST 를 db 로 덮는다. 로컬은 3330 으로 포트가 열려 있다.
DB_HOST=localhost
DB_PORT=3330
DB_NAME=drvalue_cms
DB_USER=drvalue
DB_PASSWORD=
# 업로드 파일이 놓이는 곳. 컨테이너는 /data/uploads (bind mount), 로컬은 저장소의 data/uploads.
UPLOADS_DIR=./data/uploads

# ── 관리 도구 (cms) ───────────────────────────────────────────────────
# openssl rand -hex 32
DIRECTUS_SECRET=
# 최초 관리자. 부팅 때 한 번만 쓴다. 스크립트(smoke·seed)도 이 계정으로 들어간다.
ADMIN_EMAIL=admin@drvalue.co.kr
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:3350
# 공개 화면 주소. 쉼표로 여러 개.
CORS_ORIGIN=http://localhost:3400

# ── 사내 IAM 로그인 (cms 확장 iam-bridge) ─────────────────────────────
# Core 는 SSO 를 막는다. cms/extensions/directus-extension-iam-bridge 가 대신한다.
# 비워 두면 꺼진 채로 돌고 로컬 로그인만 동작한다.
IAM_BRIDGE_ENABLED=false
IAM_BRIDGE_IAM_BASE=https://iam.drvalue.co.kr
# IAM 이 돌려보낼 주소. IAM 쪽 화이트리스트에 같은 값이 등록돼 있어야 한다.
IAM_BRIDGE_CALLBACK_URL=http://localhost:3350/iam-bridge/callback
# ── 누가 들어오나 (인가). 아무것도 안 채우면 전부 거부한다.
# 1) IAM 그룹 — 「drvalue 테넌트의 root 사용자」. IAM 토큰의 groups 에서 이 그룹
#    (uuid. 이름은 안 받는다 — "Default" 는 어디에나 있다)에 아래 역할로 속한 사람.
#    PLATFORM_ADMIN 은 그냥 통과.
#    값을 모르면 비워 두고 한 번 로그인해 본다 — 거부 로그에 그룹 id·역할이 찍힌다.
IAM_BRIDGE_GROUP=
IAM_BRIDGE_GROUP_ROLES=OWNER,ADMIN
# 2) (선택) 사내 게이트웨이 root/iam · tenant/by-root. PHP 가 쓰던 길.
#    지금 닿는 게이트웨이는 x-user-* 헤더를 요구해 403 이라 비워 둔다.
IAM_BRIDGE_ROUTE_BASE=
IAM_BRIDGE_TENANT_CODE=drvalue
# 3) (선택) 이메일 허용 목록. "iam이메일:directus이메일" 을 쉼표로. 위 둘과 무관하게 통과.
IAM_BRIDGE_ACCOUNTS=
# ── 어느 Directus 계정으로 들어오나. seat 가 3이라 여러 사람이 한 계정을 쓴다.
# 통과한 사람은 ACCOUNTS 의 매핑, 없으면 이 계정. sync 가 이 계정의 비밀번호를
# 파생값으로 바꾼다 — 스크립트는 directus.py 가 파생값으로 다시 시도하므로 계속 돈다.
IAM_BRIDGE_DEFAULT_ACCOUNT=admin@drvalue.co.kr
#
# 켠 뒤에 반드시 한 번: python3 cms/scripts/iam_bridge_sync.py
# 계정 비밀번호를 사람이 모르는 파생값으로 바꿔야 IAM 이 유일한 입구가 된다.
