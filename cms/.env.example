# openssl rand -hex 32
DIRECTUS_SECRET=

# 최초 관리자 계정. 부팅 시 한 번만 쓰인다.
ADMIN_EMAIL=admin@drvalue.co.kr
ADMIN_PASSWORD=

PUBLIC_URL=http://localhost:3350
# 공개 사이트(Vite) 주소. 쉼표로 여러 개.
CORS_ORIGIN=http://localhost:3100

# ── 사내 IAM 로그인 (선택) ────────────────────────────────────────────
# Directus Core 는 SSO 를 막는다(실측: sso_enabled 라이선스 게이트).
# 확장은 막지 않으므로 extensions/directus-extension-iam-bridge 가 대신한다.
# 비워 두면 기능이 꺼진 채로 돌고 기존 로컬 로그인만 동작한다.
IAM_BRIDGE_ENABLED=false
IAM_BRIDGE_IAM_BASE=https://iam.drvalue.co.kr
# route.drvalue.co.kr 는 지금 라우트가 하나도 안 걸려 있다(모든 경로 404).
# 실제로 닿는 주소는 아래다. 다만 이 다리가 부르는 root/iam 은 게이트웨이가
# 넣어 주는 x-user-* 를 요구해서, 이 주소로는 로그인이 끝까지 안 간다.
# route.* 가 복구되면 그쪽으로 되돌린다 — main-server/README.md 참고.
IAM_BRIDGE_ROUTE_BASE=https://api.growchat.co.kr/api/serv
# IAM 에 화이트리스트로 등록해야 한다. 로그인·토큰교환에서 같은 값을 써야 한다.
IAM_BRIDGE_CALLBACK_URL=http://localhost:3350/iam-bridge/callback
IAM_BRIDGE_TENANT_CODE=drvalue
# IAM 이메일 → Directus 계정 매핑. "iam이메일:directus이메일" 을 쉼표로.
# 비밀번호는 적지 않는다 — SECRET 에서 파생시킨다.
# seat 가 3명이라 여기 적을 수 있는 것도 최대 3개다. 없는 사람은 거부된다.
IAM_BRIDGE_ACCOUNTS=
#
# 켠 뒤에 반드시 한 번 돌려라:
#   python3 scripts/iam_bridge_sync.py
# Core 는 로컬 로그인 창을 끌 수 없다. 다리는 문을 하나 더 만들 뿐이라,
# 계정 비밀번호를 사람이 모르는 파생값으로 바꿔야 IAM 이 유일한 입구가 된다.
